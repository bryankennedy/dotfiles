# Forge repos on the Mac use the nix OpenSSH (docs/decisions/INFRA-321.md).
# Only repos with a forge remote read ~/.gitconfig-darwin. Stow links it on
# the Mac; the VMs do not have it, and git skips a missing include.
[includeIf "hasconfig:remote.*.url:ssh://git@git.bck.dev:2222/**"]
	path = ~/.gitconfig-darwin
[includeIf "hasconfig:remote.*.url:ssh://git.bck.dev:2222/**"]
	path = ~/.gitconfig-darwin
[includeIf "hasconfig:remote.*.url:git@git.bck.dev:*/**"]
	path = ~/.gitconfig-darwin

[core]
	excludesfile = ~/.gitignore_global
	editor = vim
[diff]
	push = matching
[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "status"]
	changed = green
	untracked = cyan
	added = yellow
[color "diff"]
	new = green bold
	frag = magenta bold
	meta = yellow bold
	old = red bold
[init]
	defaultBranch = main
[user]
	name = bryan kennedy
	email = bryan@mysteryexperience.com
[push]
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
