#!/usr/bin/env bun
// herdr-fleet — materialize one local herdr workspace per VM, each attached to
// that VM's remote herdr server via `herdr --remote <name>-herdr`.
//
// Source of truth: ~/.config/herdr/fleet.json, generated from the ansible
// inventory by `ansible-playbook playbooks/herdr-fleet.yml` (in the private
// infrastructure repo, ~/src/infrastructure/ansible — or `make fleet` from its
// root). This script refuses to run when that inventory is missing; see below.
// Add a VM to the inventory, re-run that playbook, re-run this — the new VM
// shows up as a workspace. Idempotent: workspaces that already exist are left
// untouched, so it is safe to re-run at login or after a reboot.
//
// Usage:
//   herdr-fleet               attach every reachable VM (skips unreachable + existing)
//   herdr-fleet --reattach    also revive existing workspaces whose remote session died
//   herdr-fleet --force       attach even VMs that fail the SSH health check
//   herdr-fleet --only a,b    restrict to the named VMs
//   herdr-fleet --dry-run     print what it would do; change nothing
//   herdr-fleet --no-inventory-check  trust fleet.json without checking the inventory
//   herdr-fleet --help        print the usage summary above
//
// After a reboot the local server can restore the VM workspaces while their SSH
// sessions stay dead — each pane falls back to a bare login shell. Plain re-runs
// skip those ("workspace exists, leaving as-is"). `--reattach` inspects each
// existing VM workspace: if no pane is running anything but a shell, it re-runs
// the `herdr --remote` command in place; live sessions are left untouched.

import { readFileSync, existsSync } from "node:fs";
import { homedir } from "node:os";
import { execFile } from "node:child_process";
import { promisify } from "node:util";

const pexec = promisify(execFile);
const FLEET_PATH = `${homedir()}/.config/herdr/fleet.json`;

// The private ansible repo that generates FLEET_PATH. It has moved once already
// (standalone ~/src/ansible -> the infrastructure monorepo), and the move went
// unnoticed for a month: hf-sync's `cd` failed, the playbook never ran, and this
// script kept attaching a decommissioned VM out of a fleet.json that nothing
// could tell was stale. HERDR_FLEET_ANSIBLE_DIR overrides the path without an
// edit; the preflight below makes the next move fatal instead of invisible.
const ANSIBLE_DIR =
  process.env.HERDR_FLEET_ANSIBLE_DIR || `${homedir()}/src/infrastructure/ansible`;
const INVENTORY = `${ANSIBLE_DIR}/inventory/hosts.yml`;
const SYNC_CMD = `(cd ${ANSIBLE_DIR} && ansible-playbook playbooks/herdr-fleet.yml)`;

const argv = process.argv.slice(2);

if (argv.includes("--help") || argv.includes("-h")) {
  console.log(`herdr-fleet (alias: hf) — one local herdr workspace per fleet VM.

Reads the fleet from
  ${FLEET_PATH}
and, for each VM, creates a herdr workspace labelled with the VM name running
\`herdr --remote <vm>-herdr\` — so every VM's remote herdr is one workspace away.
Idempotent: VMs that already have a workspace are left alone, so it is safe to
re-run at login or after a reboot.

Usage:
  hf                  attach every reachable VM (skips unreachable + existing)
  hf --reattach       also revive existing workspaces whose remote session died
  hf --force          attach even VMs that fail the SSH health check
  hf --only a,b       restrict to the named VMs
  hf --dry-run        print what it would do; change nothing
  hf --no-inventory-check
                      skip the inventory preflight (see below)
  hf --help, -h       show this help

Requires a running local herdr server — run this from inside herdr.

The fleet file is generated from the private ansible inventory
  ${INVENTORY}
Regenerate it after editing the inventory with \`hf-sync\`:
  ${SYNC_CMD}

Preflight: fleet.json is a build artifact, so this refuses to run when the
inventory it is built from is missing — otherwise a moved or unavailable
ansible repo leaves a stale VM list in service indefinitely. Set
HERDR_FLEET_ANSIBLE_DIR to point at the repo if it moves, or
--no-inventory-check to run against fleet.json alone. Hosts present in
fleet.json but no longer in the inventory are reported and skipped.

After a reboot the local server can restore VM workspaces while their SSH
sessions stay dead — each pane falls back to a bare login shell. Plain re-runs
skip those; --reattach re-runs the \`herdr --remote\` command in place for any
workspace whose panes are all sitting at a bare shell. See docs/herdr-fleet.md.`);
  process.exit(0);
}

const DRY = argv.includes("--dry-run");
const FORCE = argv.includes("--force");
const REATTACH = argv.includes("--reattach");
const NO_INV_CHECK = argv.includes("--no-inventory-check");
const onlyRaw =
  argv.find((a) => a.startsWith("--only="))?.slice("--only=".length) ??
  (argv.includes("--only") ? argv[argv.indexOf("--only") + 1] : null);
const only = onlyRaw ? new Set(onlyRaw.split(",").map((s) => s.trim())) : null;

function die(msg) {
  console.error(`herdr-fleet: ${msg}`);
  process.exit(1);
}

// A failing herdr CLI call still emits its JSON-RPC-ish object with an `error`
// member naming the reason — on stderr, where the success payload goes to
// stdout. execFile only reports "exited 1", so lift that payload onto the thrown
// error: without it every failure looks alike and the caller has to guess which
// one it was. Both streams are checked because which one carries the payload is
// herdr's choice, not ours, and it costs nothing to not depend on it.
function herdrError(...streams) {
  for (const s of streams) {
    if (!s) continue;
    try {
      const parsed = JSON.parse(String(s).trim());
      if (parsed?.error?.code) return parsed.error;
    } catch {
      // not JSON; try the next stream
    }
  }
  return null;
}

// The herdr CLI prints one JSON-RPC-ish object per call on stdout.
async function herdr(...args) {
  let stdout;
  try {
    ({ stdout } = await pexec("herdr", args, { maxBuffer: 8 << 20 }));
  } catch (e) {
    const payload = herdrError(e.stderr, e.stdout);
    if (!payload) throw e;
    const err = new Error(payload.message || payload.code);
    err.herdrCode = payload.code;
    err.herdrMessage = payload.message || "";
    throw err;
  }
  const out = stdout.trim();
  return out ? JSON.parse(out) : null;
}

// Warm, non-interactive reachability probe. With ControlMaster=auto this also
// primes the shared connection, so the subsequent `herdr --remote` is instant.
async function reachable(remote) {
  try {
    await pexec(
      "ssh",
      ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", remote, "true"],
      { timeout: 15_000 },
    );
    return true;
  } catch {
    return false;
  }
}

// A pane whose foreground process is nothing but a login shell is idle — the
// command that used to run there (our `herdr --remote` client) has exited.
const SHELLS = new Set(["zsh", "bash", "fish", "sh", "dash", "ksh", "login"]);
function isShellProc(fp) {
  const name = (fp.argv0 || fp.name || fp.argv?.[0] || "").replace(/^-/, "");
  return SHELLS.has(name);
}

async function panesFor(workspaceId) {
  try {
    const res = await herdr("pane", "list", "--workspace", workspaceId);
    return res?.result?.panes ?? [];
  } catch {
    return [];
  }
}

// A VM workspace's remote session is "alive" if any of its panes is running
// something other than a bare shell. When every pane is idle at a shell prompt
// (the reboot case), it's dead and safe to re-run the launch command into it.
async function remoteAlive(workspaceId) {
  const panes = await panesFor(workspaceId);
  for (const p of panes) {
    let info;
    try {
      info = await herdr("pane", "process-info", "--pane", p.pane_id);
    } catch {
      continue;
    }
    const procs = info?.result?.process_info?.foreground_processes ?? [];
    if (procs.some((fp) => !isShellProc(fp))) return { alive: true, panes };
  }
  return { alive: false, panes };
}

// --- preflight: fleet.json is an artifact, the inventory is the source -------
// Reading fleet.json alone cannot distinguish a current VM list from one frozen
// at the last successful sync. Refuse to guess: if the inventory it is built
// from isn't there, the list is unverifiable and a decommissioned VM in it will
// be attached forever. This is the check whose absence hid the last repo move.
if (!NO_INV_CHECK && !existsSync(INVENTORY)) {
  die(
    `cannot find the ansible inventory at\n` +
      `    ${INVENTORY}\n` +
      `  ${FLEET_PATH} is generated from it, so with the inventory gone there is\n` +
      `  no way to tell whether that file still describes the fleet. Either the\n` +
      `  private ansible repo moved again, or it is not checked out here.\n\n` +
      `  Point at it:  export HERDR_FLEET_ANSIBLE_DIR=/path/to/ansible\n` +
      `  Or edit the default in bin/bin/herdr-fleet and the hf-sync alias in\n` +
      `  zsh/aliases-core.zsh (both in ~/src/dotfiles).\n` +
      `  To run anyway against fleet.json alone:  hf --no-inventory-check`,
  );
}

// Host keys under the inventory's `vms: hosts:` block, minus any that opted out
// of the launcher with `herdr_fleet: false` — mirroring roles/herdr_fleet's
// fleet.json template. Deliberately a shallow read of a file whose shape we
// own, not a YAML implementation: it returns null when the shape is anything
// but the expected one, and callers then skip the comparison rather than act on
// a bad parse.
function inventoryVmNames(text) {
  const lines = text.split("\n");
  const vmsIdx = lines.findIndex((l) => /^\s*vms:\s*$/.test(l));
  if (vmsIdx === -1) return null;
  const hostsIdx = lines.findIndex((l, i) => i > vmsIdx && /^\s*hosts:\s*$/.test(l));
  if (hostsIdx === -1) return null;
  const indent = lines[hostsIdx].search(/\S/);
  const names = new Set();
  let current = null;
  for (let i = hostsIdx + 1; i < lines.length; i++) {
    const line = lines[i];
    if (!line.trim() || /^\s*#/.test(line)) continue;
    const col = line.search(/\S/);
    if (col <= indent) break; // dedented out of the vms group
    const host = line.match(/^\s*([A-Za-z0-9_.-]+):\s*$/);
    if (host && col === indent + 2) {
      current = host[1];
      names.add(current);
      continue;
    }
    if (current && /^\s*herdr_fleet:\s*(false|no)\s*$/i.test(line)) names.delete(current);
  }
  return names.size ? names : null;
}

// --- load the fleet ---------------------------------------------------------
let fleet;
try {
  fleet = JSON.parse(readFileSync(FLEET_PATH, "utf8"));
} catch (e) {
  die(
    `cannot read ${FLEET_PATH} (${e.code || e.message}).\n` +
      `  Generate it with: ${SYNC_CMD}`,
  );
}
if (!Array.isArray(fleet) || fleet.length === 0) die(`${FLEET_PATH} is empty`);

// --- drift: fleet.json vs the inventory it claims to come from ---------------
// A successful sync makes these identical. Any difference means fleet.json
// predates an inventory edit, so say which way it drifted and drop the hosts
// that no longer exist rather than trying to SSH to them.
let drift = null;
if (!NO_INV_CHECK) {
  const invNames = inventoryVmNames(readFileSync(INVENTORY, "utf8"));
  if (invNames) {
    const stale = fleet.filter((v) => !invNames.has(v.name)).map((v) => v.name);
    const fleetNames = new Set(fleet.map((v) => v.name));
    const missing = [...invNames].filter((n) => !fleetNames.has(n));
    if (stale.length || missing.length) {
      console.warn(`! ${FLEET_PATH}\n  is out of date with ${INVENTORY}:`);
      if (stale.length)
        console.warn(`    gone from the inventory, skipping: ${stale.join(", ")}`);
      if (missing.length)
        console.warn(`    in the inventory but not attached: ${missing.join(", ")}`);
      console.warn(`  Regenerate with hf-sync:  ${SYNC_CMD}\n`);
      fleet = fleet.filter((v) => invNames.has(v.name));
      drift = { stale: stale.length, missing: missing.length };
    }
  }
}
if (fleet.length === 0) die(`no VMs left in ${FLEET_PATH} after the inventory check`);

if (only) fleet = fleet.filter((v) => only.has(v.name));
if (fleet.length === 0) die("no VMs matched --only");

// --- require a running herdr server ----------------------------------------
// Every reason this call can fail used to collapse into "no running server",
// which sends you looking for a server that is in fact running fine. Upgrading
// the herdr binary under a live server is the common case: the CLI then refuses
// on a protocol mismatch, and the remedy is a restart, not a start.
const indent = (s) => String(s).split("\n").join("\n    ");
let listed;
try {
  listed = await herdr("workspace", "list");
} catch (e) {
  if (e.herdrCode === "protocol_mismatch") {
    die(
      `the herdr CLI and the running server are different versions.\n` +
        `  Upgrading the binary does not touch a server already running, so the\n` +
        `  two have to be brought back in step. herdr's own instructions:\n\n` +
        `    ${indent(e.herdrMessage)}\n`,
    );
  }
  if (e.herdrCode && e.herdrCode !== "server_not_running") {
    // An error herdr named but this script has no advice for. Print what herdr
    // said rather than substituting a guess — the guess is what caused this.
    die(`herdr refused \`workspace list\` (${e.herdrCode}):\n    ${indent(e.herdrMessage)}`);
  }
  die("no running herdr server — start herdr first, then run this inside it.");
}
const wsIdByLabel = new Map(
  (listed?.result?.workspaces ?? []).map((w) => [w.label, w.workspace_id]),
);
const existing = new Set(wsIdByLabel.keys());

// --- health-check all VMs in parallel --------------------------------------
const checked = await Promise.all(
  fleet.map(async (vm) => ({ vm, up: FORCE || (await reachable(vm.remote)) })),
);

// --- create a workspace per new, reachable VM ------------------------------
let created = 0;
let present = 0;
let down = 0;
let reattached = 0;
const cmdFor = (vm) => `herdr --remote ${vm.remote} --remote-keybindings server`;
for (const { vm, up } of checked) {
  if (existing.has(vm.name)) {
    if (!REATTACH) {
      console.log(`= ${vm.name} — workspace exists, leaving as-is`);
      present++;
      continue;
    }
    // --reattach: revive the workspace only if its remote session has died.
    const workspaceId = wsIdByLabel.get(vm.name);
    const { alive, panes } = await remoteAlive(workspaceId);
    if (alive) {
      console.log(`= ${vm.name} — remote session live, leaving as-is`);
      present++;
      continue;
    }
    if (!up) {
      console.warn(
        `x ${vm.name} — session dead but ${vm.remote} unreachable; skipping. Use --force to reattach anyway.`,
      );
      down++;
      continue;
    }
    const targetPane = panes[0]?.pane_id;
    if (!targetPane) {
      console.error(`! ${vm.name} — no pane found in workspace ${workspaceId}; skipping.`);
      continue;
    }
    const cmd = cmdFor(vm);
    if (DRY) {
      console.log(`~ ${vm.name} — would reattach dead session in ${targetPane}: ${cmd}`);
      reattached++;
      continue;
    }
    await herdr("pane", "run", targetPane, cmd);
    console.log(`~ ${vm.name} — reattached dead session (${vm.remote}) in ${targetPane}`);
    reattached++;
    continue;
  }
  if (!up) {
    console.warn(
      `x ${vm.name} — unreachable (${vm.remote}); skipping. Use --force to attach anyway.`,
    );
    down++;
    continue;
  }
  const cmd = cmdFor(vm);
  if (DRY) {
    console.log(`+ ${vm.name} — would create workspace and run: ${cmd}`);
    created++;
    continue;
  }
  const res = await herdr("workspace", "create", "--label", vm.name, "--no-focus");
  const paneId = res?.result?.root_pane?.pane_id;
  if (!paneId) {
    console.error(`! ${vm.name} — created workspace but no pane id returned; skipping run.`);
    continue;
  }
  await herdr("pane", "run", paneId, cmd);
  console.log(
    `+ ${vm.name} — attached (${vm.remote}) in workspace ${res.result.workspace.workspace_id}`,
  );
  created++;
}

const reattachSummary = REATTACH ? `, ${reattached} reattached` : "";
console.log(
  `\nherdr-fleet: ${created} attached${reattachSummary}, ${present} already present, ${down} unreachable.`,
);
// Repeat the drift warning under the summary: the one above scrolls off behind
// a long fleet, and an unnoticed warning is how the stale list survived before.
if (drift) {
  console.warn(
    `herdr-fleet: fleet.json is stale (${drift.stale} removed, ${drift.missing} missing). Run hf-sync.`,
  );
}
