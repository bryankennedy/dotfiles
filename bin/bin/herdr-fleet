#!/usr/bin/env bun
// herdr-fleet — keep herdr's saved SSH machines in step with the fleet.
//
// herdr (preview channel, 2026-09-06 and later) can hold a catalog of saved SSH
// machines: the local client connects to each one's remote server in the
// background, and their workspaces, agents and notifications appear in the
// local sidebar under "Local". That replaced this script's original job, which
// was to open one local workspace per VM with a nested `herdr --remote` client
// in it. Nested clients streamed a remote UI into a pane; the local server never
// saw the remote's agents. Saved machines are the fix, and they persist across
// restarts, so nothing has to be re-run after a reboot — plain `herdr` reconnects.
//
// What is left to automate is keeping that catalog equal to the inventory.
// Source of truth: ~/.config/herdr/fleet.json, generated from the ansible
// inventory by `ansible-playbook playbooks/herdr-fleet.yml` (in the private
// infrastructure repo, ~/src/infrastructure/ansible — or `make fleet` from its
// root; `hf-sync` from the shell). This script refuses to run when that
// inventory is missing; see below. Add a VM to the inventory, `hf-sync`, `hf` —
// the new VM is a saved machine. Remove one, `hf-sync`, `hf --prune` — gone.
//
// Usage:
//   herdr-fleet               save every fleet VM missing from the catalog
//   herdr-fleet --prune       also remove saved fleet machines whose VM is gone
//   herdr-fleet --force       try to save VMs that fail the SSH health check
//   herdr-fleet --only a,b    restrict to the named VMs
//   herdr-fleet --dry-run     print what it would do; change nothing
//   herdr-fleet --no-inventory-check  trust fleet.json without checking the inventory
//   herdr-fleet --help        print the usage summary above
//
// The catalog itself is herdr's: ~/.local/state/herdr/client/endpoints.json,
// edited only through `herdr machine …`. It holds labels, SSH targets and
// session names — never keys or credentials — and is not stowed from this repo.

import { readFileSync, existsSync } from "node:fs";
import { homedir } from "node:os";
import { execFile, spawn } from "node:child_process";
import { promisify } from "node:util";

const pexec = promisify(execFile);
const FLEET_PATH = `${homedir()}/.config/herdr/fleet.json`;

// The private ansible repo that generates FLEET_PATH. It has moved once already
// (standalone ~/src/ansible -> the infrastructure monorepo), and the move went
// unnoticed for a month: hf-sync's `cd` failed, the playbook never ran, and this
// script kept attaching a decommissioned VM out of a fleet.json that nothing
// could tell was stale. HERDR_FLEET_ANSIBLE_DIR overrides the path without an
// edit; the preflight below makes the next move fatal instead of invisible.
const ANSIBLE_DIR =
  process.env.HERDR_FLEET_ANSIBLE_DIR || `${homedir()}/src/infrastructure/ansible`;
const INVENTORY = `${ANSIBLE_DIR}/inventory/hosts.yml`;
const SYNC_CMD = `(cd ${ANSIBLE_DIR} && ansible-playbook playbooks/herdr-fleet.yml)`;

const argv = process.argv.slice(2);

if (argv.includes("--help") || argv.includes("-h")) {
  console.log(`herdr-fleet (alias: hf) — saved herdr machines, one per fleet VM.

Reads the fleet from
  ${FLEET_PATH}
and makes sure every VM in it is a saved SSH machine in the local herdr client
(\`herdr machine list\`), labelled with the VM name and targeting its
\`<vm>-herdr\` SSH alias. The client then connects to each VM's remote herdr
server in the background and shows its workspaces and agents in the sidebar —
after a reboot too, with nothing to re-run. Idempotent: VMs already saved are
left alone.

Usage:
  hf                  save every fleet VM missing from the catalog
  hf --prune          also remove saved fleet machines whose VM is gone
  hf --force          try to save VMs that fail the SSH health check
  hf --only a,b       restrict to the named VMs
  hf --dry-run        print what it would do; change nothing
  hf --no-inventory-check
                      skip the inventory preflight (see below)
  hf --help, -h       show this help

Run it from a terminal: \`herdr machine add\` prepares the remote server and may
need an interactive approval (host key, install) the first time.

The fleet file is generated from the private ansible inventory
  ${INVENTORY}
Regenerate it after editing the inventory with \`hf-sync\`:
  ${SYNC_CMD}

Preflight: fleet.json is a build artifact, so this refuses to run when the
inventory it is built from is missing — otherwise a moved or unavailable
ansible repo leaves a stale VM list in service indefinitely. Set
HERDR_FLEET_ANSIBLE_DIR to point at the repo if it moves, or
--no-inventory-check to run against fleet.json alone. Hosts present in
fleet.json but no longer in the inventory are reported and skipped.

Only machines whose target ends in "-herdr" are treated as fleet machines;
anything you saved by hand with another target is never touched or reported.
See docs/herdr-fleet.md.`);
  process.exit(0);
}

const DRY = argv.includes("--dry-run");
const FORCE = argv.includes("--force");
const PRUNE = argv.includes("--prune");
const NO_INV_CHECK = argv.includes("--no-inventory-check");
const onlyRaw =
  argv.find((a) => a.startsWith("--only="))?.slice("--only=".length) ??
  (argv.includes("--only") ? argv[argv.indexOf("--only") + 1] : null);
const only = onlyRaw ? new Set(onlyRaw.split(",").map((s) => s.trim())) : null;

function die(msg) {
  console.error(`herdr-fleet: ${msg}`);
  process.exit(1);
}

// `herdr machine list --json` is a plain JSON array; the other machine
// subcommands print prose and exit non-zero on failure.
async function machineList() {
  let stdout;
  try {
    ({ stdout } = await pexec("herdr", ["machine", "list", "--json"], { maxBuffer: 8 << 20 }));
  } catch (e) {
    die(
      `\`herdr machine list --json\` failed:\n    ${String(e.stderr || e.message).trim()}\n` +
        `  Saved machines need a herdr from the preview channel (2026-09-06 or later).`,
    );
  }
  const out = stdout.trim();
  return out ? JSON.parse(out) : [];
}

// `machine add` may prompt (host-key approval, a remote install) and prepares
// the remote server, so it gets the real terminal rather than captured pipes:
// a swallowed prompt is a hang with no explanation.
function herdrInteractive(...args) {
  return new Promise((resolve) => {
    const child = spawn("herdr", args, { stdio: "inherit" });
    child.on("error", (e) => resolve({ ok: false, error: e.message }));
    child.on("exit", (code) => resolve({ ok: code === 0, code }));
  });
}

// Warm, non-interactive reachability probe. `machine add` on a host that is
// asleep would sit in SSH until it times out; an asleep VM is the normal case
// on this fleet, so probe first and say so.
async function reachable(remote) {
  try {
    await pexec(
      "ssh",
      ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", remote, "true"],
      { timeout: 15_000 },
    );
    return true;
  } catch {
    return false;
  }
}

// --- preflight: fleet.json is an artifact, the inventory is the source -------
// Reading fleet.json alone cannot distinguish a current VM list from one frozen
// at the last successful sync. Refuse to guess: if the inventory it is built
// from isn't there, the list is unverifiable and a decommissioned VM in it will
// be saved forever. This is the check whose absence hid the last repo move.
if (!NO_INV_CHECK && !existsSync(INVENTORY)) {
  die(
    `cannot find the ansible inventory at\n` +
      `    ${INVENTORY}\n` +
      `  ${FLEET_PATH} is generated from it, so with the inventory gone there is\n` +
      `  no way to tell whether that file still describes the fleet. Either the\n` +
      `  private ansible repo moved again, or it is not checked out here.\n\n` +
      `  Point at it:  export HERDR_FLEET_ANSIBLE_DIR=/path/to/ansible\n` +
      `  Or edit the default in bin/bin/herdr-fleet and the hf-sync alias in\n` +
      `  zsh/aliases-core.zsh (both in ~/src/dotfiles).\n` +
      `  To run anyway against fleet.json alone:  hf --no-inventory-check`,
  );
}

// Host keys under the inventory's `vms: hosts:` block, minus any that opted out
// of the fleet with `herdr_fleet: false` — mirroring roles/herdr_fleet's
// fleet.json template. Deliberately a shallow read of a file whose shape we
// own, not a YAML implementation: it returns null when the shape is anything
// but the expected one, and callers then skip the comparison rather than act on
// a bad parse.
function inventoryVmNames(text) {
  const lines = text.split("\n");
  const vmsIdx = lines.findIndex((l) => /^\s*vms:\s*$/.test(l));
  if (vmsIdx === -1) return null;
  const hostsIdx = lines.findIndex((l, i) => i > vmsIdx && /^\s*hosts:\s*$/.test(l));
  if (hostsIdx === -1) return null;
  const indent = lines[hostsIdx].search(/\S/);
  const names = new Set();
  let current = null;
  for (let i = hostsIdx + 1; i < lines.length; i++) {
    const line = lines[i];
    if (!line.trim() || /^\s*#/.test(line)) continue;
    const col = line.search(/\S/);
    if (col <= indent) break; // dedented out of the vms group
    const host = line.match(/^\s*([A-Za-z0-9_.-]+):\s*$/);
    if (host && col === indent + 2) {
      current = host[1];
      names.add(current);
      continue;
    }
    if (current && /^\s*herdr_fleet:\s*(false|no)\s*$/i.test(line)) names.delete(current);
  }
  return names.size ? names : null;
}

// --- load the fleet ---------------------------------------------------------
let fleet;
try {
  fleet = JSON.parse(readFileSync(FLEET_PATH, "utf8"));
} catch (e) {
  die(
    `cannot read ${FLEET_PATH} (${e.code || e.message}).\n` +
      `  Generate it with: ${SYNC_CMD}`,
  );
}
if (!Array.isArray(fleet) || fleet.length === 0) die(`${FLEET_PATH} is empty`);

// --- drift: fleet.json vs the inventory it claims to come from ---------------
// A successful sync makes these identical. Any difference means fleet.json
// predates an inventory edit, so say which way it drifted and drop the hosts
// that no longer exist rather than saving them.
let drift = null;
if (!NO_INV_CHECK) {
  const invNames = inventoryVmNames(readFileSync(INVENTORY, "utf8"));
  if (invNames) {
    const stale = fleet.filter((v) => !invNames.has(v.name)).map((v) => v.name);
    const fleetNames = new Set(fleet.map((v) => v.name));
    const missing = [...invNames].filter((n) => !fleetNames.has(n));
    if (stale.length || missing.length) {
      console.warn(`! ${FLEET_PATH}\n  is out of date with ${INVENTORY}:`);
      if (stale.length)
        console.warn(`    gone from the inventory, skipping: ${stale.join(", ")}`);
      if (missing.length)
        console.warn(`    in the inventory but not in fleet.json: ${missing.join(", ")}`);
      console.warn(`  Regenerate with hf-sync:  ${SYNC_CMD}\n`);
      fleet = fleet.filter((v) => invNames.has(v.name));
      drift = { stale: stale.length, missing: missing.length };
    }
  }
}
if (fleet.length === 0) die(`no VMs left in ${FLEET_PATH} after the inventory check`);

if (only) fleet = fleet.filter((v) => only.has(v.name));
if (fleet.length === 0) die("no VMs matched --only");

// --- the catalog as herdr has it -------------------------------------------
// Matched by SSH target, not label: the target is what the client dials and
// what fleet.json owns; the label is cosmetic and fixed up below if it drifted.
const catalog = await machineList();
const byTarget = new Map(catalog.map((m) => [m.target, m]));
const fleetTargets = new Set(fleet.map((v) => v.remote));

// --- save every fleet VM that is not already a machine ----------------------
let saved = 0;
let present = 0;
let down = 0;
let failed = 0;
let relabelled = 0;
for (const vm of fleet) {
  const have = byTarget.get(vm.remote);
  if (have) {
    if (have.label !== vm.name) {
      if (DRY) {
        console.log(`~ ${vm.name} — would relabel "${have.label}" -> "${vm.name}"`);
      } else {
        const r = await herdrInteractive("machine", "rename", have.id, "--label", vm.name);
        if (!r.ok) console.error(`! ${vm.name} — rename failed (exit ${r.code ?? r.error})`);
        else console.log(`~ ${vm.name} — relabelled from "${have.label}"`);
      }
      relabelled++;
    } else {
      console.log(`= ${vm.name} — saved${have.enabled ? "" : " (disabled)"}, leaving as-is`);
    }
    present++;
    continue;
  }
  if (!FORCE && !(await reachable(vm.remote))) {
    console.warn(
      `x ${vm.name} — unreachable (${vm.remote}); skipping. Re-run when it is awake, or --force.`,
    );
    down++;
    continue;
  }
  if (DRY) {
    console.log(`+ ${vm.name} — would run: herdr machine add ${vm.remote} --label ${vm.name}`);
    saved++;
    continue;
  }
  const r = await herdrInteractive("machine", "add", vm.remote, "--label", vm.name);
  if (!r.ok) {
    console.error(
      `! ${vm.name} — \`herdr machine add ${vm.remote}\` failed (exit ${r.code ?? r.error}).\n` +
        `  If it needed an approval, run that command yourself in a terminal.`,
    );
    failed++;
    continue;
  }
  console.log(`+ ${vm.name} — saved (${vm.remote})`);
  saved++;
}

// --- fleet-shaped machines the fleet no longer knows -----------------------
// A VM removed from the inventory leaves its machine behind, dialling a host
// that may not exist. Only targets shaped like ours are considered, so a
// machine saved by hand for some other box is never reported, let alone
// removed. Removal is opt-in (--prune): the machine also stops being visible in
// the sidebar, and a wrong guess about --only would otherwise hide a VM.
const orphans = catalog.filter((m) => /-herdr$/.test(m.target) && !fleetTargets.has(m.target));
let pruned = 0;
if (orphans.length && only) {
  // With --only the fleet in view is partial, so "not in the fleet" proves nothing.
  console.warn(`\n! ${orphans.length} saved fleet machine(s) not in --only; not checked for pruning.`);
} else {
  for (const m of orphans) {
    if (!PRUNE) {
      console.warn(`? ${m.label} — saved machine for ${m.target} is not in the fleet; \`hf --prune\` removes it`);
      continue;
    }
    if (DRY) {
      console.log(`- ${m.label} — would run: herdr machine remove ${m.id}`);
      pruned++;
      continue;
    }
    const r = await herdrInteractive("machine", "remove", m.id);
    if (!r.ok) console.error(`! ${m.label} — remove failed (exit ${r.code ?? r.error})`);
    else {
      console.log(`- ${m.label} — removed (${m.target})`);
      pruned++;
    }
  }
}

console.log(
  `\nherdr-fleet: ${saved} saved, ${present} already present` +
    (relabelled ? ` (${relabelled} relabelled)` : "") +
    `, ${down} unreachable, ${failed} failed` +
    (PRUNE ? `, ${pruned} pruned` : orphans.length && !only ? `, ${orphans.length} to prune` : "") +
    (DRY ? " (dry run)" : "") +
    ".",
);
// Repeat the drift warning under the summary: the one above scrolls off behind
// a long fleet, and an unnoticed warning is how the stale list survived before.
if (drift) {
  console.warn(
    `herdr-fleet: fleet.json is stale (${drift.stale} removed, ${drift.missing} missing). Run hf-sync.`,
  );
}
if (failed) process.exit(1);
